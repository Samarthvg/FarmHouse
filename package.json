{
  "name": "farmhouse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply farmhouse --local",
    "db:migrate:remote": "wrangler d1 migrations apply farmhouse --remote",
    "db:import:local": "node scripts/import-sheet.ts data/sheet3.csv > data/import.sql && wrangler d1 execute farmhouse --local --file data/import.sql",
    "db:import:remote": "node scripts/import-sheet.ts data/sheet3.csv > data/import.sql && wrangler d1 execute farmhouse --remote --file data/import.sql",
    "user:add": "node scripts/add-user.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}

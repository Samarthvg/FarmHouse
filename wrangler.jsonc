{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmhouse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farmhouse",
      "database_id": "d8a340e3-4c9b-420d-8910-303c89ae4c7f",
      "migrations_dir": "migrations"
    }
  ],
  // Bill photos (photos/) and weekly database backups (backups/). Private: only reachable through the API.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "farmhouse-files" }],
  // Sunday 02:00 in India.
  "triggers": { "crons": ["30 20 * * 6"] },
  "observability": { "enabled": true }
}
